# ==============================================================================
# ÓPTICA PROFESIONAL (B2C) & SMART OPTICAL (B2B) — SALTA, ARGENTINA
# Variables de Entorno (Copiar a .env para personalizar en Producción)
# ==============================================================================

# WhatsApp de Atención B2C en Salta (formato internacional sin '+' ni espacios)
VITE_WHATSAPP_NUMBER_B2C=5493870000000

# WhatsApp de Atención Mayorista B2B - SMART OPTICAL
VITE_WHATSAPP_NUMBER_B2B=5493870000000

# URL del Web App publicado desde Google Apps Script (doGet / doPost)
VITE_GOOGLE_SHEETS_WEBAPP_URL=

# ID del Pixel de Meta Ads (Facebook / Instagram)
VITE_META_PIXEL_ID=

# Preset de Tema por defecto: theme-neutral | theme-boutique | theme-clinical
VITE_DEFAULT_BRAND_THEME=theme-neutral
